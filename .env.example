# ==========================================================
# Database (PostgreSQL + PostGIS)
# ==========================================================
POSTGRES_USER=tmaps
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=tmaps
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Untuk dev di host. Di Docker Compose, host otomatis diarahkan ke service `db`.
DATABASE_URL=postgresql://tmaps:ganti-dengan-password-kuat@localhost:5432/tmaps

# ==========================================================
# API
# ==========================================================
API_PORT=3000
# Pisahkan beberapa origin dengan koma bila perlu.
# Untuk akses lewat Tailscale/IP VPS, tambahkan juga http://<ip-vps>:5173.
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=168

# ==========================================================
# 2FA (TOTP)
# ==========================================================
# Kunci enkripsi AES-256-GCM untuk secret 2FA di DB.
# Buat dengan: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
# Masa berlaku sesi sementara setelah password benar, sebelum TOTP diverifikasi.
TWO_FA_PENDING_TTL_MINUTES=5
# Durasi lock setelah percobaan TOTP gagal melebihi batas.
TWO_FA_LOCK_MINUTES=15
TWO_FA_MAX_ATTEMPTS=5

# ==========================================================
# Rate Limit (Fase 3)
# ==========================================================
# Max percobaan login per IP dalam window (5 menit)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=5
# Max percobaan TOTP per IP dalam window (5 menit)
RATE_LIMIT_TOTP_MAX=10
RATE_LIMIT_TOTP_WINDOW_MINUTES=5

# ==========================================================
# Seed admin awal (wajib diisi sebelum `bun run db:seed`)
# ==========================================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ganti-password-admin-yang-kuat

# ==========================================================
# Upload gambar
# ==========================================================
# Folder penyimpanan file gambar. Di Docker Compose nilainya diarahkan ke
# /data/uploads (named volume `uploads`); nilai ini dipakai saat API dijalankan
# langsung di host.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=5

# ==========================================================
# Monitoring (dipakai mulai Fase 3)
# ==========================================================
PING_TICK_SECONDS=5
PING_TIMEOUT_MS=2000
PING_CONCURRENCY=10
PING_FAIL_THRESHOLD=2
PING_LOG_RETENTION_DAYS=30

# ==========================================================
# Web (Vite)
# ==========================================================
# URL API yang dipanggil browser. Untuk akses lewat Tailscale/IP VPS,
# ganti localhost dengan IP VPS agar tidak menunjuk ke komputer pengguna.
VITE_API_URL=http://localhost:3000
# Interval polling status perangkat (ms)
VITE_STATUS_POLL_INTERVAL_MS=3000

# ==========================================================
# Database (PostgreSQL + PostGIS)
# ==========================================================
POSTGRES_USER=tmaps
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=tmaps
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Untuk dev di host. Di Docker Compose, host otomatis diarahkan ke service `db`.
DATABASE_URL=postgresql://tmaps:ganti-dengan-password-kuat@localhost:5432/tmaps

# ==========================================================
# API
# ==========================================================
API_PORT=3000
# Pisahkan beberapa origin dengan koma bila perlu.
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=168

# ==========================================================
# Seed admin awal (wajib diisi sebelum `bun run db:seed`)
# ==========================================================
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ganti-password-admin-yang-kuat

# ==========================================================
# Upload gambar
# ==========================================================
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=5

# ==========================================================
# Monitoring (dipakai mulai Fase 3)
# ==========================================================
PING_TICK_SECONDS=5
PING_TIMEOUT_MS=2000
PING_LOG_RETENTION_DAYS=30

# ==========================================================
# Web (Vite)
# ==========================================================
VITE_API_URL=http://localhost:3000

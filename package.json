{
  "name": "tmaps",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun --env-file=.env --cwd apps/api run dev",
    "dev:web": "bun --env-file=.env --cwd apps/web run dev",
    "typecheck": "bun --env-file=.env --cwd apps/api run typecheck && bun --env-file=.env --cwd apps/web run typecheck",
    "db:generate": "bun --env-file=.env --cwd apps/api run db:generate",
    "db:migrate": "bun --env-file=.env --cwd apps/api run db:migrate",
    "db:seed": "bun --env-file=.env --cwd apps/api run db:seed"
  },
  "packageManager": "bun@1.4.4"
}

{
  "name": "tmaps",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun --env-file=\"$PWD/.env\" run --cwd apps/api dev",
    "dev:web": "bun --env-file=\"$PWD/.env\" run --cwd apps/web dev",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck",
    "db:generate": "bun --env-file=\"$PWD/.env\" run --cwd apps/api db:generate",
    "db:migrate": "bun --env-file=\"$PWD/.env\" run --cwd apps/api db:migrate",
    "db:seed": "bun --env-file=\"$PWD/.env\" run --cwd apps/api db:seed"
  },
  "packageManager": "bun@1.4.4"
}
